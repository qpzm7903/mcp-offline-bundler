{
  "name": "mcp-offline-bundler",
  "version": "0.0.0",
  "description": "CLI tool that builds offline runtime bundles for npm-based MCP servers (linux-x64).",
  "type": "module",
  "license": "MIT",
  "bin": {
    "mcp-offline-bundler": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "cli": "node dist/cli.js",
    "bundle": "node dist/cli.js build -m mcp.manifest.yaml --out dist"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "execa": "^9.5.1",
    "fs-extra": "^11.2.0",
    "tar": "^7.4.3",
    "yaml": "^2.5.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.11.1",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^20.16.10",
    "@typescript-eslint/eslint-plugin": "^8.8.0",
    "@typescript-eslint/parser": "^8.8.0",
    "eslint": "^9.11.1",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.8.0",
    "vitest": "^2.1.1"
  }
}
